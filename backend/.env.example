# gemini | ollama | none
AI_PROVIDER=none
# One key, or several comma-separated keys (rotated when one is exhausted/expired)
GEMINI_API_KEYS=key-one,key-two
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback models tried in order per key
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Embeddings: minilm | gemini | none
SANGAM_EMBEDDING_BACKEND=minilm
# 1 = Supabase Postgres, 0 = local sqlite
USE_SUPABASE=1
