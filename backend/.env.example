# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: either a URL (percent-encode special characters, no [brackets]) ...
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# ... or discrete values (preferred when the password has special characters).
# POSTGRES_HOST=aws-0-eu-north-1.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_PASSWORD=<password>
# Leave both unset to use local SQLite (backend/db.sqlite3).

SANGAM_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sangam-step2.vercel.app
# Optional regexes for Vercel preview URLs of the frontend project:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://team-027-frontend(-[a-z0-9-]+)?\.vercel\.app$
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://sangam-step2.vercel.app

# Daily monitoring job (/api/v1/cron/daily/). Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Leave empty to disable the endpoint; IIC can still run checks from Monitoring & alerts.
CRON_SECRET=

# Email (console backend prints emails to the terminal in development)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sangam IIC <no-reply@example.org>

# Local AI (optional). Only localhost URLs are ever called.
SANGAM_OLLAMA_ENABLED=false
SANGAM_OLLAMA_URL=http://127.0.0.1:11434/api/chat
SANGAM_OLLAMA_MODEL=qwen3:8b

# Google Calendar (optional). Create an OAuth "Web application" client in Google Cloud and
# add the redirect URI below to its authorised redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/oauth/callback/
# Optional Fernet key for stored Google tokens (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
SANGAM_TOKEN_ENCRYPTION_KEY=
